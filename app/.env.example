# URL pública del sitio (metadata, vista previa al compartir). Sin barra final.
# En Vercel se puede dejar vacía: se usa el dominio de producción del proyecto.
NEXT_PUBLIC_SITE_URL=
# Dominio raíz para los subdominios por proyecto: {slug}.ROOT_DOMAIN. Vacío en desarrollo.
ROOT_DOMAIN=
# Proyecto al que lleva la raíz del dominio principal.
DEFAULT_PROJECT_SLUG=torre-algarrobo
# Base de los medios (Cloudflare R2 o CDN). Vacío = /media de la carpeta public.
NEXT_PUBLIC_MEDIA_BASE_URL=
# Supabase (todavía no se usa: la demo corre con datos locales).
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # solo servidor; nunca con prefijo NEXT_PUBLIC_
